<?xml version="1.0" encoding="utf-8"?>
<!-- Saath keeps the journal, origin story and conversations on the device by
     design. Excluding them from cloud/device-transfer backups is part of that
     promise: nothing about a relationship leaves the phone without an explicit
     pairing step. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
